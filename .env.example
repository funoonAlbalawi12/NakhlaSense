# Environment Variables for NakhlaSense
# Copy this file to .env.local and fill in your actual values

# Firebase Configuration (Google/Gmail Integration)
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=123456789
REACT_APP_FIREBASE_APP_ID=1:123456789:web:abcdef123456
REACT_APP_FIREBASE_FUNCTIONS_REGION=us-central1

# Frontend Services
REACT_APP_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Example Firebase Config:
# REACT_APP_FIREBASE_API_KEY=AIzaSyBxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# REACT_APP_FIREBASE_AUTH_DOMAIN=nakhlasense.firebaseapp.com
# REACT_APP_FIREBASE_PROJECT_ID=nakhlasense
# REACT_APP_FIREBASE_STORAGE_BUCKET=nakhlasense.appspot.com
# REACT_APP_FIREBASE_MESSAGING_SENDER_ID=123456789012
# REACT_APP_FIREBASE_APP_ID=1:123456789012:web:abcdef123456789
# REACT_APP_FIREBASE_FUNCTIONS_REGION=us-central1
